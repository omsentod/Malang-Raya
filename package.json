        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-prettier": "^5.5.6",
        "laravel-vite-plugin": "^3.0.0",
        "prettier": "^3.8.3",
        "tailwindcss": "^4.0.0",
        "vite": "^8.0.0"
    }
